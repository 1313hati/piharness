{
  "name": "piharness",
  "version": "0.1.0",
  "description": "Lean Pi Coding Harness \u2014 a TypeScript app around the Pi coding-agent SDK",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "piharness": "./dist/cli.js",
    "harness": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "PIHARNESS_AGENT_DIR=$(mktemp -d) tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
