diff --git i/bin/omarchy-local-ai-coder w/bin/omarchy-local-ai-coder
new file mode 100755
index 0000000..ac34fd0
--- /dev/null
+++ w/bin/omarchy-local-ai-coder
@@ -0,0 +1,212 @@
+#!/usr/bin/env python3
+"""Local integration: share coder.sh's native server with the Local AI panel."""
+import contextlib
+import fcntl
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+import urllib.request
+
+HOME = Path.home()
+BACKEND = Path(__file__).resolve().with_name('omarchy-local-ai')
+CODER = HOME / 'coder.sh'
+STATE = HOME / '.local/state/coder'
+KEYS = {'nvidia:0', 'nvidia:1'}
+
+
+def fail(message):
+    print('local-ai: ' + message, file=sys.stderr)
+    raise SystemExit(1)
+
+
+def _k(n):
+    """49293 -> '49.3k', 1580 -> '1.6k', 900 -> '900'."""
+    if not isinstance(n, (int, float)) or n <= 0:
+        return '0'
+    if n < 1000:
+        return str(int(n))
+    if n < 100000:
+        return f'{n / 1000:.1f}k'
+    return f'{n / 1000:.0f}k'
+
+
+def track(slot):
+    """Turn one /slots entry into token, context and decode-rate figures.
+
+    A rate needs two samples, so the previous one is kept in
+    ~/.local/state/coder/live.json: the delta over the interval is t/s, and a
+    new id_task means a new request.
+    """
+    if not slot:
+        return {}
+    nxt = slot.get('next_token') or [{}]
+    nxt = nxt[0] if isinstance(nxt, list) and nxt else {}
+    prompt = int(slot.get('n_prompt_tokens') or 0)
+    cached = int(slot.get('n_prompt_tokens_cache') or 0)
+    out = int(nxt.get('n_decoded') or 0)
+    task = slot.get('id_task')
+    processing = bool(slot.get('is_processing'))
+    ctx = int(slot.get('n_ctx') or 0)
+
+    now = time.time()
+    prev, requests = {}, 0
+    path = STATE / 'live.json'
+    try:
+        prev = json.loads(path.read_text())
+        requests = int(prev.get('requests') or 0)
+    except (OSError, ValueError):
+        prev = {}
+
+    # The panel polls every 1.5-5 s, but the bar also runs snapshot every 30 s,
+    # so short gaps reuse the last rate instead of reporting noise.
+    speed = float(prev.get('speed') or 0.0)
+    same = prev.get('task') == task and prev.get('decoded') is not None
+    if same:
+        dt = now - float(prev.get('ts') or 0)
+        dd = out - int(prev.get('decoded') or 0)
+        if dt >= 1.0 and dt < 120 and dd >= 0:
+            speed = dd / dt
+    else:
+        speed = 0.0
+    if task is not None and prev.get('task') != task:
+        requests += 1
+
+    try:
+        STATE.mkdir(parents=True, exist_ok=True)
+        path.write_text(json.dumps({'task': task, 'decoded': out, 'ts': now, 'requests': requests, 'speed': speed}))
+    except OSError:
+        pass
+
+    return {
+        'processing': processing,
+        'tokens': f'{_k(prompt)} in · {_k(out)} out',
+        'contextUsed': f'{_k(prompt + out)} / {_k(ctx)}' if ctx else _k(prompt + out),
+        'promptTokens': prompt,
+        'cachedTokens': cached,
+        'outputTokens': out,
+        'speed': f'{speed:.1f} t/s' if speed > 0 else ('generating' if processing else 'idle'),
+        'requests': requests,
+        'task': task,
+    }
+
+
+def native_state():
+    pid = None
+    for p in Path('/proc').glob('[0-9]*'):
+        try:
+            if p.stat().st_uid != os.getuid() or (p / 'exe').resolve().name != 'llama-server':
+                continue
+            args = (p / 'cmdline').read_bytes().split(b'\0')
+            if b'qwen38' in args and b'8080' in args:
+                pid = int(p.name)
+                break
+        except (OSError, RuntimeError):
+            pass
+    result = {'state': 'loading' if pid else 'stopped', 'pid': pid, 'context': 65536}
+    if pid:
+        try:
+            opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+            with opener.open('http://127.0.0.1:8080/health', timeout=1) as r:
+                ready = json.load(r).get('status') == 'ok'
+            if ready:
+                result['state'] = 'ready'
+                try:
+                    with opener.open('http://127.0.0.1:8080/slots', timeout=1) as r:
+                        slots = json.load(r)
+                    if isinstance(slots, list) and slots:
+                        slot = max(slots, key=lambda x: (x.get('id_task') or 0))
+                        result['context'] = int(slot.get('n_ctx') or result['context'])
+                        result.update(track(slot))
+                except (OSError, ValueError, KeyError, TypeError):
+                    pass
+        except (OSError, ValueError, KeyError):
+            pass
+    return result
+
+
+def snapshot():
+    return json.loads(subprocess.check_output([str(BACKEND), 'snapshot'], text=True))
+
+
+@contextlib.contextmanager
+def start_lock():
+    STATE.mkdir(parents=True, exist_ok=True)
+    with (STATE / 'plugin-start.lock').open('a') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            fail('A model is starting. Wait for startup to finish.')
+        yield
+
+
+def ensure_cards_free():
+    s = snapshot()
+    for d in s.get('deployments', []):
+        if d.get('state') != 'error' and KEYS.intersection(d.get('keys', [])):
+            fail('Stop ' + d.get('name', 'the Docker model') + ' in Local AI before starting coder.sh.')
+
+
+def terminal(action):
+    # Run in Local AI's chosen folder; each agent uses coder.sh's own configuration.
+    settings = HOME / '.local/state/omarchy/local-ai/settings.json'
+    try:
+        folder = Path(json.loads(settings.read_text()).get('folder', str(HOME))).expanduser()
+    except (OSError, ValueError):
+        folder = HOME
+    os.chdir(folder if folder.is_dir() else HOME)
+    env = dict(os.environ, SERVER_LAUNCH='background', KEEP_SERVER='1')
+    if action in ('start', 'pi', 'claude', 'hermes', 'piharness'):
+        with start_lock():
+            ensure_cards_free()
+            rc = subprocess.call(['bash', str(CODER), '--start'], env=env)
+        if rc:
+            return rc
+        if action != 'start':
+            return subprocess.call(['bash', str(CODER), action], env=env)
+        return 0
+    return subprocess.call(['bash', str(CODER), '--' + action], env=env)
+
+
+def main():
+    args = sys.argv[1:]
+    if args == ['snapshot']:
+        s = snapshot()
+        c = native_state()
+        s['coder'] = c
+        if c['pid']:
+            for g in s.get('gpus', []):
+                if g.get('key') in KEYS:
+                    g.update(busy=True, held=True)
+            for k in s.get('kinds', []):
+                k['free'] = [key for key in k.get('free', []) if key not in KEYS]
+        print(json.dumps(s))
+    elif len(args) == 1 and args[0] in ('coder-start', 'coder-stop', 'coder-pi', 'coder-claude', 'coder-hermes', 'coder-piharness', 'coder-logs'):
+        subprocess.Popen(['omarchy-launch-tui', '--app-id=org.omarchy.coder', str(Path(__file__).resolve()),
+                          '--terminal', args[0][6:]], start_new_session=True,
+                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    elif len(args) == 2 and args[0] == '--terminal' and args[1] in ('start', 'stop', 'pi', 'claude', 'hermes', 'piharness', 'logs'):
+        try:
+            rc = terminal(args[1])
+        except SystemExit as e:
+            rc = e.code
+        if rc or args[1] == 'logs':
+            try:
+                input('\nPress Enter to close. ')
+            except EOFError:
+                pass
+        return rc
+    elif args and args[0] == 'run':
+        with start_lock():
+            if native_state()['pid'] and len(args) > 2 and KEYS.intersection(args[2].split(',')):
+                fail('Stop coder.sh in Local AI before starting another model on these GPUs.')
+            return subprocess.call([str(BACKEND), *args])
+    else:
+        os.execv(str(BACKEND), [str(BACKEND), *args])
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
