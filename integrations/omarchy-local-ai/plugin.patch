new file mode 100755
index 0000000..fd7aad9
--- /dev/null
+++ w/bin/omarchy-local-ai-coder
@@ -0,0 +1,391 @@
+#!/usr/bin/env python3
+"""Local integration: share the coder servers' native llama-server with the Local AI panel.
+
+Two profiles, one port: coder.sh (Qwen3.8 27B, alias qwen38) and codernew.sh
+(MiniCPM-V 4.7 35B-A3B, alias minicpm47). Each keeps its own state
+directory and its own Start/Stop row in the panel; only one runs at a time,
+because the wrapper stops the other before a Start.
+"""
+import contextlib
+import fcntl
+import json
+import os
+from pathlib import Path
+import datetime
+import subprocess
+import sys
+import time
+import urllib.request
+
+HOME = Path.home()
+BACKEND = Path(__file__).resolve().with_name('omarchy-local-ai')
+KEYS = {'nvidia:0', 'nvidia:1'}
+ACTIONS = ('start', 'stop', 'pi', 'claude', 'hermes', 'piharness', 'logs')
+PROFILES = {
+    'codernew': {
+        'label': 'CODERNEW \u00b7 MINICPM-V 4.7 35B-A3B',
+        'short': 'minicpm-v 4.7 35B-A3B',
+        'script': HOME / 'codernew.sh',
+        'state': HOME / '.local/state/codernew',
+        'alias': 'minicpm47',
+        'port': 8080,
+        'context': 98304,
+        'model': 'Q4_K_M',
+        'note': '96k ctx',
+    },
+    'coder': {
+        'label': 'CODER.SH \u00b7 QWEN3.8 27B',
+        'short': 'qwen3.8 27B',
+        'script': HOME / 'coder.sh',
+        'state': HOME / '.local/state/coder',
+        'alias': 'qwen38',
+        'port': 8080,
+        'context': 65536,
+        'model': 'UD-Q4_K_XL',
+        'note': 'MTP',
+    },
+}
+# The profile a command is acting on; set in main() before anything reads state.
+ACTIVE = PROFILES['coder']
+
+
+def fail(message):
+    print('local-ai: ' + message, file=sys.stderr)
+    raise SystemExit(1)
+
+
+def _k(n):
+    """49293 -> '49.3k', 1580 -> '1.6k', 900 -> '900'."""
+    if not isinstance(n, (int, float)) or n <= 0:
+        return '0'
+    if n < 1000:
+        return str(int(n))
+    if n < 100000:
+        return f'{n / 1000:.1f}k'
+    return f'{n / 1000:.0f}k'
+
+
+def track(slot):
+    """Turn one /slots entry into token, context and decode-rate figures.
+
+    A rate needs two samples, so the previous one is kept in
+    ~/.local/state/coder/live.json: the delta over the interval is t/s, and a
+    new id_task means a new request.
+    """
+    if not slot:
+        return {}
+    nxt = slot.get('next_token') or [{}]
+    nxt = nxt[0] if isinstance(nxt, list) and nxt else {}
+    prompt = int(slot.get('n_prompt_tokens') or 0)
+    cached = int(slot.get('n_prompt_tokens_cache') or 0)
+    out = int(nxt.get('n_decoded') or 0)
+    task = slot.get('id_task')
+    processing = bool(slot.get('is_processing'))
+    ctx = int(slot.get('n_ctx') or 0)
+
+    now = time.time()
+    prev, requests = {}, 0
+    path = ACTIVE['state'] / 'live.json'
+    try:
+        prev = json.loads(path.read_text())
+        requests = int(prev.get('requests') or 0)
+    except (OSError, ValueError):
+        prev = {}
+
+    # The panel polls every 1.5-5 s, but the bar also runs snapshot every 30 s,
+    # so short gaps reuse the last rate instead of reporting noise. Averaging
+    # over the task gives a real number on the first poll, when there is no
+    # second sample to difference against yet.
+    speed = float(prev.get('speed') or 0.0)
+    last = float(prev.get('lastSpeed') or 0.0)
+    started = float(prev.get('taskStart') or 0.0)
+    same = prev.get('task') == task and prev.get('decoded') is not None
+    if not same:
+        speed = 0.0
+        started = now
+    dt = now - float(prev.get('ts') or 0)
+    dd = out - int(prev.get('decoded') or 0)
+    if same and dt >= 1.0 and dt < 120 and dd >= 0:
+        speed = dd / dt
+    elif same and out > 0 and now > started:
+        speed = out / (now - started)
+    if speed > 0:
+        last = speed
+    if task is not None and prev.get('task') != task:
+        requests += 1
+    account(prompt, out, task, prev)
+
+    try:
+        ACTIVE['state'].mkdir(parents=True, exist_ok=True)
+        path.write_text(json.dumps({'task': task, 'decoded': out, 'ts': now, 'requests': requests,
+                                    'speed': speed, 'lastSpeed': last, 'taskStart': started}))
+    except OSError:
+        pass
+
+    return {
+        'processing': processing,
+        'tokens': f'{_k(prompt)} in · {_k(out)} out',
+        'contextUsed': f'{_k(prompt + out)} / {_k(ctx)}' if ctx else _k(prompt + out),
+        'promptTokens': prompt,
+        'cachedTokens': cached,
+        'outputTokens': out,
+        'speed': f'{speed:.1f} t/s' if speed > 0 else (
+            f'idle · last {last:.1f} t/s' if not processing and last > 0 else
+            ('starting' if processing else 'idle')),
+        'speedValue': round(speed or last, 1),
+        'requests': requests,
+        'task': task,
+    }
+
+
+
+def _usage_path():
+    return ACTIVE['state'] / 'usage.json'
+
+
+def _load_usage():
+    try:
+        data = json.loads(_usage_path().read_text())
+        if isinstance(data.get('days'), dict):
+            return data
+    except (OSError, ValueError):
+        pass
+    return {'days': {}}
+
+
+def account(prompt, out, task, prev):
+    """Add what this task has produced to a per-day ledger.
+
+    The calendar grid needs history, and llama-server keeps none: it reports the
+    live task only. Each task id is remembered the first time it is seen (its
+    prompt and one request), and output is counted by delta afterwards, so a
+    task that started before the panel was opened is still counted once.
+    """
+    if task is None:
+        return
+    data = _load_usage()
+    seen = data.setdefault('seen', {})
+    day = time.strftime('%Y-%m-%d')
+    rec = data['days'].setdefault(day, {'in': 0, 'out': 0, 'requests': 0})
+    changed = False
+    key = str(task)
+    if key not in seen:
+        rec['in'] += prompt
+        rec['out'] += out
+        rec['requests'] += 1
+        seen[key] = out
+        changed = True
+    elif out > int(seen[key]):
+        rec['out'] += out - int(seen[key])
+        seen[key] = out
+        changed = True
+    if changed:
+        # keep the ledger small: the last 200 tasks are enough to avoid recounts
+        if len(seen) > 200:
+            for k in list(seen)[:-200]:
+                del seen[k]
+        try:
+            ACTIVE['state'].mkdir(parents=True, exist_ok=True)
+            _usage_path().write_text(json.dumps(data))
+        except OSError:
+            pass
+
+
+def merge_usage(s, prof=None):
+    """Fold the ledger into the snapshot's lifetime, so the calendar grid counts
+    the local server as well as the gateway."""
+    global ACTIVE
+    if prof is not None:
+        ACTIVE = prof
+    data = _load_usage()
+    days_by_date = data.get('days') or {}
+    if not days_by_date:
+        return s
+    life = dict(s.get('life') or {})
+    theirs = list(life.get('days') or [])
+    theirs_req = int(life.get('requests') or 0)
+    start = float(life.get('start') or 0)
+
+    dates = sorted(days_by_date)
+    first = datetime.date.fromisoformat(dates[0])
+    base = datetime.date.fromtimestamp(start) if start else first
+    theirs_start = base
+    if first < base:
+        base = first
+    last = datetime.date.today()
+    n = max(1, (last - base).days + 1)
+    series = [0] * n
+    # the backend's own days end today, so they right-align
+    for i, v in enumerate(theirs):
+        idx = n - len(theirs) + i
+        if 0 <= idx < n:
+            series[idx] += int(v or 0)
+    req = theirs_req
+    for d in dates:
+        rec = days_by_date[d]
+        idx = (datetime.date.fromisoformat(d) - base).days
+        if 0 <= idx < n:
+            series[idx] += int(rec.get('in') or 0) + int(rec.get('out') or 0)
+            req += int(rec.get('requests') or 0)
+
+    life['start'] = int(datetime.datetime.combine(base, datetime.time()).timestamp())
+    life['today'] = n - 1
+    life['days'] = series
+    life['requests'] = req
+    if not life.get('since') and req:
+        life['since'] = (theirs_start if start else base).strftime('%b %-d')
+    s['life'] = life
+    s['total'] = sum(series)
+    return s
+
+
+def native_state(prof):
+    global ACTIVE
+    ACTIVE = prof
+    pid = None
+    want = prof['alias'].encode()
+    port = str(prof['port']).encode()
+    for p in Path('/proc').glob('[0-9]*'):
+        try:
+            if p.stat().st_uid != os.getuid() or (p / 'exe').resolve().name != 'llama-server':
+                continue
+            args = (p / 'cmdline').read_bytes().split(b'\0')
+            if want in args and port in args:
+                pid = int(p.name)
+                break
+        except (OSError, RuntimeError):
+            pass
+    result = {'state': 'loading' if pid else 'stopped', 'pid': pid, 'context': prof['context'],
+              'alias': prof['alias'], 'label': prof['label'], 'short': prof.get('short', ''),
+              'model': prof['model'], 'note': prof['note']}
+    if pid:
+        try:
+            opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+            with opener.open(f"http://127.0.0.1:{prof['port']}/health", timeout=1) as r:
+                ready = json.load(r).get('status') == 'ok'
+            if ready:
+                result['state'] = 'ready'
+                try:
+                    with opener.open(f"http://127.0.0.1:{prof['port']}/slots", timeout=1) as r:
+                        slots = json.load(r)
+                    if isinstance(slots, list) and slots:
+                        slot = max(slots, key=lambda x: (x.get('id_task') or 0))
+                        result['context'] = int(slot.get('n_ctx') or result['context'])
+                        result.update(track(slot))
+                except (OSError, ValueError, KeyError, TypeError):
+                    pass
+        except (OSError, ValueError, KeyError):
+            pass
+    return result
+
+
+def snapshot():
+    return json.loads(subprocess.check_output([str(BACKEND), 'snapshot'], text=True))
+
+
+@contextlib.contextmanager
+def start_lock():
+    ACTIVE['state'].mkdir(parents=True, exist_ok=True)
+    with (ACTIVE['state'] / 'plugin-start.lock').open('a') as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            fail('A model is starting. Wait for startup to finish.')
+        yield
+
+
+def ensure_cards_free():
+    s = snapshot()
+    for d in s.get('deployments', []):
+        if d.get('state') != 'error' and KEYS.intersection(d.get('keys', [])):
+            fail('Stop ' + d.get('name', 'the Docker model') + ' in Local AI before starting coder.sh.')
+
+
+def running_other(prof):
+    """The other profile's server, if it is up: both listen on the same port."""
+    global ACTIVE
+    for other in PROFILES.values():
+        if other is prof:
+            continue
+        if native_state(other)['pid']:
+            ACTIVE = prof
+            return other
+    ACTIVE = prof
+    return None
+
+
+def terminal(prof, action):
+    global ACTIVE
+    ACTIVE = prof
+    # Run in Local AI's chosen folder; each agent uses its coder script's own configuration.
+    settings = HOME / '.local/state/omarchy/local-ai/settings.json'
+    try:
+        folder = Path(json.loads(settings.read_text()).get('folder', str(HOME))).expanduser()
+    except (OSError, ValueError):
+        folder = HOME
+    os.chdir(folder if folder.is_dir() else HOME)
+    env = dict(os.environ, SERVER_LAUNCH='background', KEEP_SERVER='1')
+    if action in ('start', 'pi', 'claude', 'hermes', 'piharness'):
+        with start_lock():
+            ensure_cards_free()
+            other = running_other(prof)
+            if other:
+                print(f"{other['label'].split(' \u00b7 ')[0]} is running on port "
+                      f"{other['port']}; stopping it for {prof['label'].split(' \u00b7 ')[0]}.", flush=True)
+                subprocess.call(['bash', str(other['script']), '--stop'], env=env)
+            rc = subprocess.call(['bash', str(prof['script']), '--start'], env=env)
+        if rc:
+            return rc
+        if action != 'start':
+            return subprocess.call(['bash', str(prof['script']), action], env=env)
+        return 0
+    return subprocess.call(['bash', str(prof['script']), '--' + action], env=env)
+
+
+def main():
+    args = sys.argv[1:]
+    if args == ['snapshot']:
+        s = snapshot()
+        states = {key: native_state(prof) for key, prof in PROFILES.items()}
+        for key, state in states.items():
+            s[key] = state
+            s = merge_usage(s, PROFILES[key])
+        if any(state['pid'] for state in states.values()):
+            for g in s.get('gpus', []):
+                if g.get('key') in KEYS:
+                    g.update(busy=True, held=True)
+            for k in s.get('kinds', []):
+                k['free'] = [key for key in k.get('free', []) if key not in KEYS]
+        print(json.dumps(s))
+    elif len(args) == 1 and '-' in args[0] and args[0].split('-', 1)[0] in PROFILES \
+            and args[0].split('-', 1)[1] in ACTIONS:
+        prof = args[0].split('-', 1)[0]
+        subprocess.Popen(['omarchy-launch-tui', '--app-id=org.omarchy.' + prof, str(Path(__file__).resolve()),
+                          '--terminal', prof, args[0].split('-', 1)[1]], start_new_session=True,
+                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    elif args and args[0] == '--terminal' and len(args) in (2, 3) \
+            and (args[-1] in ACTIONS) and (len(args) == 2 or args[1] in PROFILES):
+        prof_name, action = (args[1], args[2]) if len(args) == 3 else ('coder', args[1])
+        try:
+            rc = terminal(PROFILES[prof_name], action)
+        except SystemExit as e:
+            rc = e.code
+        if rc or action == 'logs':
+            try:
+                input('\nPress Enter to close. ')
+            except EOFError:
+                pass
+        return rc
+    elif args and args[0] == 'run':
+        with start_lock():
+            busy = next((p for p in PROFILES.values() if native_state(p)['pid']), None)
+            if busy and len(args) > 2 and KEYS.intersection(args[2].split(',')):
+                fail(f"Stop {busy['script'].name} in Local AI before starting another model on these GPUs.")
+            return subprocess.call([str(BACKEND), *args])
+    else:
+        os.execv(str(BACKEND), [str(BACKEND), *args])
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
